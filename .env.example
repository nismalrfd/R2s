# Copy to .env (local) and set the same names in Vercel > Settings > Environment Variables.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_DOMAIN=
ZOHO_API_DOMAIN=

# Mail OTP (Gmail SMTP + App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=info@r2srealtors.com
SMTP_PASS=your_16_char_google_app_password
MAIL_FROM=R2s Realtors <info@r2srealtors.com>
OTP_SECRET=long_random_string

# SMS OTP (Telinfy — hub.telinfy.com -> Settings -> Security -> API Keys)
SMS_API_KEY=PASTE_YOUR_TELINFY_API_KEY_HERE
SMS_TEMPLATE_ID=PASTE_YOUR_APPROVED_TEMPLATE_ID_HERE
SMS_SENDER_NAME=RSPMPL
# Must match the DLT-approved template text EXACTLY, with {#var#} where the code goes.
SMS_MESSAGE_TEMPLATE=Your OTP for R2S Realtors is {#var#}. Valid for 10 minutes. - R2S Realtors

# Property approval e-mail: Zoho CRM calls POST /api/property-approved with this secret
# (header "x-webhook-secret"). Use a long random string (min 16 chars).
APPROVAL_WEBHOOK_SECRET=long_random_string
